DJANGO_SETTINGS_MODULE=config.settings.local
DJANGO_SECRET_KEY=local-development-only-replace-before-sharing
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
DB_ENGINE=mysql
MYSQL_DATABASE=transparency
MYSQL_USER=transparency
MYSQL_PASSWORD=local-only-app-password
MYSQL_ROOT_PASSWORD=local-only-root-password
MYSQL_HOST=db
MYSQL_PORT=3306
APP_VERSION=2026.11.22
MAX_IMPORT_BYTES=2097152
MAX_IMPORT_ROWS=500
LOG_LEVEL=INFO
# демонстрационная запись 12345 / 12345 для стенда (создаёт manage.py demo_users)
ENABLE_SYNTHETIC_LOGIN=0
