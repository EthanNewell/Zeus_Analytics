# Copy to .env.staging on the server and replace every change-me value.
DJANGO_SETTINGS_MODULE=config.settings.staging
DJANGO_SECRET_KEY=change-me-generate-a-random-secret-of-at-least-50-characters
DJANGO_ALLOWED_HOSTS=staging.example.org
DJANGO_CSRF_TRUSTED_ORIGINS=https://staging.example.org
DB_ENGINE=mysql
MYSQL_DATABASE=transparency
MYSQL_USER=transparency
MYSQL_PASSWORD=change-me-application-password
MYSQL_ROOT_PASSWORD=change-me-root-password
MYSQL_HOST=db
MYSQL_PORT=3306
APP_IMAGE=transparency:replace-with-commit-sha
APP_VERSION=replace-with-commit-sha
MAX_IMPORT_BYTES=2097152
MAX_IMPORT_ROWS=500
LOG_LEVEL=INFO
